<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Nori.Core / Nori.Lux target plain net10.0; their browser-only paths are guarded at
         runtime (OperatingSystem.IsBrowser), which the platform analyzer cannot see -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <!-- No OutDir into Bin: a WASM app is a tree of framework files and static assets, not
         one assembly, and does not belong in the folder the desktop binaries share -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.11" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- The scenes: the same assembly WPFDemo draws with -->
    <ProjectReference Include="..\DemoScenes\DemoScenes.csproj" />
    <ProjectReference Include="..\..\Core\Nori.Core.csproj" />
    <ProjectReference Include="..\..\Lux\Nori.Lux.csproj" />
    <!-- The browser host: WebGL2 on a canvas, DOM events into Nori's Hub, the JS paint loop -->
    <ProjectReference Include="..\..\Host\Web\Nori.Host.Web.csproj" />
  </ItemGroup>

  <!-- A browser has no file system, so everything the app reads is fetched over HTTP as a zip
       and mounted with MemZipStmLocator (see Program.cs). Two wads are packed into wwwroot at
       build time: Nori.wad (fonts, shaders, line-fonts ... from the Wad folder) and Demo.wad
       (the demo inputs from Demos/Data, served as the "demo:" drive). Both are gitignored. -->
  <Target Name="PackWads" BeforeTargets="ResolveProjectStaticWebAssets;BeforeBuild">
    <ZipDirectory SourceDirectory="$(ProjectDir)..\..\Wad" DestinationFile="$(ProjectDir)wwwroot\Nori.wad" Overwrite="true" />
    <ZipDirectory SourceDirectory="$(ProjectDir)..\Data" DestinationFile="$(ProjectDir)wwwroot\Demo.wad" Overwrite="true" />
    <!-- The wwwroot glob was evaluated before this target ran, so on a first build (no wads yet)
         the files would be missing from the static-asset manifest and 404 at runtime. Add them
         here, skipping any the glob already picked up. -->
    <ItemGroup>
      <Content Include="wwwroot\Nori.wad;wwwroot\Demo.wad" Exclude="@(Content)" />
    </ItemGroup>
  </Target>

</Project>
